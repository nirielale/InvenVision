DB_HOST=localhost
DB_PORT=3306
DB_NAME=invenvision
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Ruta a tesseract.exe si no esta en el PATH (opcional)
TESSERACT_CMD=

# --- Despliegue ---
# development (por defecto) o production. En production: JWT_SECRET obligatorio (mín. 32 caracteres),
# sin /docs, /redoc ni /openapi.json, y registro público desactivado salvo ALLOW_REGISTRATION=true.
ENVIRONMENT=development
# true/false. Si se omite: habilitado en development, deshabilitado en production.
# ALLOW_REGISTRATION=true
# Carpeta de fotos y escaneos. Vacío = backend/uploads. En Railway: ruta de un volumen (p. ej. /data/uploads).
UPLOAD_DIR=
